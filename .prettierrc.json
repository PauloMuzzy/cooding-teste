{
    "plugins": ["prettier-plugin-jinja-template"],
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": false,
    "trailingComma": "none",
    "bracketSameLine": true,
    "overrides": [
        {
            "files": ["*.html"],
            "options": {
                "parser": "jinja-template"
            }
        },
        {
            "files": ["*.css", "*.scss"],
            "options": {
                "parser": "css"
            }
        },
        {
            "files": ["*.js", "*.jsx", "*.ts", "*.tsx"],
            "options": {
                "parser": "babel"
            }
        },
        {
            "files": ["*.py"],
            "options": {
                "parser": "python"
            }
        }
    ]
}
